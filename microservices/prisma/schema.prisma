// Unified Prisma schema for all microservices
// This schema will be used to create the database structure

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Auth Service Models
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  password  String
  firstName String?
  lastName  String?
  isActive  Boolean  @default(true)
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sessions")
}

// Sales Service Models
model Sale {
  id          String    @id @default(uuid())
  title       String
  description String?   @db.Text
  saleDate    DateTime?
  location    String?
  organizer   String?
  status      String    @default("upcoming")
  sourceUrl   String?
  externalId  String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lots Lot[]

  @@index([status])
  @@index([saleDate])
  @@map("sales")
}

// Lots Service Models
model Lot {
  id             String    @id @default(uuid())
  title          String
  description    String?   @db.Text
  category       String?
  startingPrice  Float?
  currentPrice   Float?
  estimatedPrice Float?
  lotNumber      String?
  images         String[]  @default([])
  saleId         String
  sale           Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  favorites Favorite[]

  @@index([saleId])
  @@index([category])
  @@index([title])
  @@map("lots")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  lotId     String
  lot       Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, lotId])
  @@index([userId])
  @@map("favorites")
}

model Alert {
  id       String  @id @default(uuid())
  userId   String
  keywords String?
  category String?
  minPrice Float?
  maxPrice Float?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("alerts")
}

// Notifications Service Models
model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String    @default("email")
  subject   String
  message   String    @db.Text
  sentAt    DateTime?
  status    String    @default("pending")
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([status])
  @@map("notifications")
}
