// Prisma schema for notifications-service

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String    @default("email") // email, push
  subject   String
  message   String    @db.Text
  sentAt    DateTime?
  status    String    @default("pending") // pending, sent, failed
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([status])
  @@map("notifications")
}
