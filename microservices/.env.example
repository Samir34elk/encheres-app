# Database
DATABASE_URL=postgresql://encheres:encheres_password@localhost:5432/encheres

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Redis
REDIS_URL=redis://localhost:6379

# Services (for local development)
AUTH_SERVICE_URL=http://localhost:3001
LOTS_SERVICE_URL=http://localhost:3002
SALES_SERVICE_URL=http://localhost:3003
SCRAPER_SERVICE_URL=http://localhost:3004
NOTIFICATIONS_SERVICE_URL=http://localhost:3005

# CORS
CORS_ORIGIN=http://localhost:5173

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@encheres.com

# Environment
NODE_ENV=development
