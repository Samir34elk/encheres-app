# ================================
# APPLICATION
# ================================
APP_NAME=Enchères du Domaine
APP_VERSION=2.0.0
DEBUG=false  # ⚠️  DOIT être false en production

# ================================
# SERVER
# ================================
HOST=0.0.0.0
PORT=8000

# ================================
# DATABASE
# ================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION  # ⚠️  CHANGER EN PRODUCTION
POSTGRES_DB=encheres

DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@db:5432/encheres
DATABASE_URL_SYNC=postgresql://postgres:CHANGE_ME@db:5432/encheres

# Database Pool Configuration (v2.0.0 - Optimisé)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# ================================
# SECURITY (v2.0.0 - Renforcé)
# ================================
# ⚠️  CRITIQUE: Générer une nouvelle clé sécurisée en production
# Commande: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_GENERATE_SECURE_KEY_32_CHARS_MIN

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins - liste des domaines autorisés (séparés par des virgules)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com

# Rate Limiting (v2.0.0 - Nouveau)
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=5

# OAuth2 (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Email (Optional - for notifications)
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password
MAIL_FROM=noreply@encheres.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# Redis
REDIS_URL=redis://redis:6379/0

# Scraper
SCRAPER_INTERVAL_MINUTES=15
AUCTION_BASE_URL=https://encheres-domaine.gouv.fr
AUCTION_SALE_NUMBER=42

# Frontend
VITE_API_URL=http://localhost:8000/api/v1

# ================================
# PRODUCTION DEPLOYMENT
# ================================
# Uniquement pour le déploiement via GitHub Actions

# DockerHub credentials (à définir dans GitHub Secrets)
# DOCKERHUB_USERNAME=your_dockerhub_username
# DOCKERHUB_TOKEN=your_dockerhub_token

# Deployment server (à définir dans GitHub Secrets)
# DEPLOY_HOST=your_server_ip
# DEPLOY_USER=your_server_user
# DEPLOY_SSH_KEY=your_ssh_private_key

# Domain name
# DOMAIN_NAME=encheres.yourdomain.com

# ================================
# SECURITY CHECKLIST v2.0.0
# ================================
# ✅ SECRET_KEY généré avec au moins 32 caractères aléatoires
# ✅ POSTGRES_PASSWORD changé (mot de passe fort)
# ✅ DEBUG=false en production
# ✅ BACKEND_CORS_ORIGINS limité aux domaines autorisés uniquement
# ✅ Rate limiting activé (protection brute-force)
# ✅ httpOnly cookies pour les tokens (protection XSS)
# ✅ HTTPS activé en production via reverse proxy (nginx/caddy)
# ✅ Firewall configuré (uniquement ports 80, 443, 22)
# ✅ SSL/TLS certificats installés (Let's Encrypt recommandé)
# ✅ Backups automatiques de la base de données configurés
# ✅ Monitoring et logs centralisés (Sentry, Prometheus, etc.)
